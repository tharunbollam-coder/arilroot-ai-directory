---
import type { CollectionEntry } from 'astro:content';

interface Props {
  news: CollectionEntry<'news'>;
}

const { news } = Astro.props;

// Format pubDate cleanly
const formattedDate = new Date(news.data.pubDate).toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});

// Extract slug
const slug = news.id.replace(/\.md$/, '').split('/').pop();
---

<article 
  class="bg-paper-alt border border-line rounded-lg p-6 flex flex-col justify-between h-full hover:border-emerald/45 transition-all group"
  style="box-shadow: 0 4px 12px var(--theme-shadow);"
>
  <div>
    <!-- Badge and Date Row -->
    <div class="flex items-center justify-between gap-3 mb-4">
      <span class="font-mono text-[11px] uppercase tracking-wide border border-emerald/30 text-emerald bg-emerald-light rounded px-2.5 py-1 font-medium">
        News
      </span>
      <time datetime={new Date(news.data.pubDate).toISOString()} class="font-mono text-xs text-ink-soft">
        {formattedDate}
      </time>
    </div>

    <!-- Title with Line Clamp for Grid Uniformity -->
    <h3 class="font-display text-xl text-ink leading-snug line-clamp-2 min-h-[3.25rem] mb-3 group-hover:text-emerald transition-colors">
      <a href={`/news/${slug}`} class="no-underline text-inherit focus-visible:outline-none">
        {news.data.title}
      </a>
    </h3>

    <!-- Card Description -->
    <p class="text-ink-soft text-sm leading-relaxed line-clamp-3 min-h-[4.25rem] mb-4">
      {news.data.cardDescription}
    </p>

    <!-- Optional Tags Row -->
    {news.data.tags && news.data.tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-6">
        {news.data.tags.slice(0, 3).map((tag) => (
          <span class="tag-pill text-[10px] py-0.5 px-2">#{tag}</span>
        ))}
      </div>
    )}
  </div>

  <!-- Card Action Footer -->
  <div class="border-t border-line pt-4 mt-auto">
    <a
      href={`/news/${slug}`}
      class="w-full inline-flex items-center justify-center gap-1.5 border border-line bg-paper px-4 py-2 rounded font-mono text-xs uppercase tracking-[0.15em] hover:bg-emerald hover:border-emerald transition-all no-underline"
      style="box-shadow: 0 1px 3px var(--theme-shadow); color: var(--theme-ink);"
      onmouseenter="this.style.color='var(--theme-btn-hover-text)'"
      onmouseleave="this.style.color='var(--theme-ink)'"
    >
      <span>Read Update</span> 
      <span class="inline-block translate-y-[0.5px] font-sans">→</span>
    </a>
  </div>
</article>
