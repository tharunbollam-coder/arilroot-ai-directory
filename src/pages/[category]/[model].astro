---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Use getStaticPaths to map category and model.id for all files at build time
export async function getStaticPaths() {
  const allModels = await getCollection('models');
  
  return allModels.map(model => {
    const category = model.data.category;
    // Extract the model name slug from model.id (handles folder paths)
    const modelSlug = model.id.split('/').pop();
    
    return {
      params: {
        category,
        model: modelSlug
      },
      props: { model }
    };
  });
}

const { model } = Astro.props;

// Human-friendly mapping for category titles
const categoryDisplayNames: Record<string, string> = {
  'text-models': 'Text Models & Chatbots',
  'image-models': 'Image & Art Generators',
  'audio-models': 'Audio & Speech Synthesizers',
  'video-models': 'Video Generators',
};

const categoryDisplayName = categoryDisplayNames[model.data.category] || model.data.category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
---

<Layout 
  title={`${model.data.title} Review & Detailed Analysis - ArilRoot`}
  description={model.data.description}
>
  <div class="container mx-auto max-w-4xl px-6 py-12">
    
    <!-- Breadcrumb (mono uppercase eyebrow style) -->
    <nav class="flex mb-6 overflow-x-auto whitespace-nowrap pb-1" aria-label="Breadcrumb">
      <ol class="inline-flex items-center flex-nowrap font-mono text-xs uppercase tracking-[0.15em] text-ink-soft">
        <li class="inline-flex items-center">
          <a href="/" class="hover:text-emerald transition-colors no-underline">Home</a>
        </li>
        <li>
          <span class="mx-2 text-line select-none">·</span>
        </li>
        <li>
          <a href={`/${model.data.category}`} class="hover:text-emerald transition-colors no-underline">{categoryDisplayName}</a>
        </li>
        <li>
          <span class="mx-2 text-line select-none">·</span>
        </li>
        <li>
          <span class="text-ink truncate max-w-[140px] sm:max-w-none">{model.data.title}</span>
        </li>
      </ol>
    </nav>

    <!-- Top / Hero Section -->
    <header class="bg-paper-alt border border-line rounded-lg p-6 sm:p-10 mb-14" style="box-shadow: 0 4px 12px var(--theme-shadow);">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 md:gap-8">
        <div class="flex items-center gap-4">
          {model.data.logo && (
            <div class="logo-box w-14 h-14">
              <img 
                src={model.data.logo} 
                alt={`${model.data.title} brand mark`} 
              />
            </div>
          )}
          <div>
            <h1 class="font-display font-medium text-4xl sm:text-5xl tracking-tight text-ink leading-tight">{model.data.title}</h1>
            <p class="font-mono text-xs uppercase tracking-wide text-ink-soft mt-1">by {model.data.creator}</p>
          </div>
        </div>

        {model.data.editorsReview && (
          <div class="flex shrink-0">
            <div class="stamp">
              <span class="font-display text-2xl font-semibold text-gold">{model.data.editorsReview.rating}</span>
              <span class="font-mono text-[10px] uppercase tracking-[0.15em] text-ink-soft mt-0.5">Editor's Pick</span>
            </div>
          </div>
        )}
      </div>

      <!-- Fitted Model Description -->
      <div class="mt-6 pt-6 border-t border-line">
        <p class="font-display italic text-lg sm:text-xl text-ink-soft leading-relaxed max-w-3xl">
          "{model.data.description}"
        </p>
      </div>

      <!-- Custom Tags / Links -->
      <div class="mt-6 flex flex-wrap items-center gap-3">
        {model.data.pricingTier === 'Free' && (
          <span class="font-mono text-[11px] uppercase tracking-wide border border-emerald/30 text-emerald bg-emerald-light rounded px-2.5 py-1">Free Tier Available</span>
        )}
        {model.data.pricingTier === 'Freemium' && (
          <span class="font-mono text-[11px] uppercase tracking-wide border border-emerald/30 text-emerald bg-emerald-light rounded px-2.5 py-1">Freemium Tier</span>
        )}
        {model.data.pricingTier === 'Paid' && (
          <span class="font-mono text-[11px] uppercase tracking-wide border border-line text-ink-soft bg-paper rounded px-2.5 py-1">Paid Tier</span>
        )}
        {model.data.officialLink && (
          <a 
            href={model.data.officialLink} 
            target="_blank" 
            rel="noopener" 
            class="inline-flex items-center gap-1.5 border border-line bg-paper text-emerald hover:bg-emerald hover:border-emerald px-4 py-2 rounded font-mono text-xs uppercase tracking-wide transition-all no-underline"
            style="box-shadow: 0 1px 3px var(--theme-shadow);"
            onmouseenter="this.style.color='var(--theme-btn-hover-text)'"
            onmouseleave="this.style.color='var(--theme-emerald)'"
          >
            <span>Visit Site</span> <span class="inline-block translate-y-[-0.5px] font-sans text-xs">↗</span>
          </a>
        )}
      </div>
    </header>

    <!-- Main Content Stack (Single-Column Only) -->
    <div class="space-y-16">
      
      <!-- Introduction -->
      {model.data.introduction && (
        <section id="introduction">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Introduction</h2>
          </div>
          <p class="text-ink-soft leading-relaxed">{model.data.introduction}</p>
        </section>
      )}

      <!-- How It Works -->
      {model.data.howItWorks && (
        <section id="how-it-works">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">How It Works</h2>
          </div>
          <p class="text-ink-soft leading-relaxed">{model.data.howItWorks}</p>
        </section>
      )}

      <!-- Target Audience & Intent (Best For) -->
      {model.data.bestFor && (model.data.bestFor.who || model.data.bestFor.what) && (
        <section id="best-for">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Target Audience &amp; Intent</h2>
          </div>
          <div class="bg-paper-alt border border-line rounded-lg p-6 space-y-5" style="box-shadow: 0 4px 12px var(--theme-shadow);">
            {model.data.bestFor.who && (
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-emerald mb-1.5 font-medium">Ideal User Profiles</p>
                <p class="text-sm text-ink-soft leading-relaxed">{model.data.bestFor.who}</p>
              </div>
            )}
            {model.data.bestFor.who && model.data.bestFor.what && (
              <div class="h-px bg-line"></div>
            )}
            {model.data.bestFor.what && (
              <div>
                <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-emerald mb-1.5 font-medium">Primary Workloads</p>
                <p class="text-sm text-ink-soft leading-relaxed">{model.data.bestFor.what}</p>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Top Features -->
      {model.data.topFeatures && model.data.topFeatures.length > 0 && (
        <section id="features" class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Top Features</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            {model.data.topFeatures.map((feature) => (
              <div class="border border-line rounded-lg p-5 bg-paper-alt/60" style="box-shadow: 0 2px 8px var(--theme-shadow);">
                <span class="inline-block h-2 w-2 bg-emerald rounded-sm mb-3"></span>
                <p class="font-display text-lg text-ink mb-2">{feature.title}</p>
                <p class="text-sm text-ink-soft leading-relaxed">{feature.details}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Prompting Techniques -->
      {model.data.promptTechniques && model.data.promptTechniques.length > 0 && (
        <section id="prompting-tips" class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Prompting Techniques</h2>
          </div>
          <div class="space-y-6">
            {model.data.promptTechniques.map((tech) => (
              <div class="border border-line bg-paper-alt/40 rounded-lg p-6">
                <p class="font-display text-lg text-ink mb-3">{tech.title}</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                  <div>
                    <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-emerald mb-1">Concept</p>
                    <p class="text-sm text-ink-soft leading-relaxed">{tech.concept}</p>
                  </div>
                  <div>
                    <p class="font-mono text-[11px] uppercase tracking-[0.15em] text-emerald mb-1">Workflow</p>
                    <p class="text-sm text-ink-soft leading-relaxed">{tech.workflow}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Pricing -->
      {model.data.pricing && (model.data.pricing.free || model.data.pricing.paid) && (
        <section id="pricing" class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Pricing</h2>
          </div>
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <span class="font-display text-3xl text-ink">
              {model.data.pricing.startingPrice || (model.data.pricingTier === 'Free' ? 'Free' : 'Premium Tiers')}
            </span>
            {model.data.pricing.pricingUrl && (
              <a 
                href={model.data.pricing.pricingUrl} 
                target="_blank" 
                rel="noopener" 
                class="inline-flex items-center gap-1.5 border border-line bg-paper text-emerald hover:bg-emerald hover:border-emerald px-4 py-2 rounded font-mono text-xs uppercase tracking-wide font-medium transition-all no-underline"
                style="box-shadow: 0 1px 3px var(--theme-shadow);"
                onmouseenter="this.style.color='var(--theme-btn-hover-text)'"
                onmouseleave="this.style.color='var(--theme-emerald)'"
              >
                <span>Full pricing details</span> <span class="inline-block translate-y-[-0.5px] font-sans text-xs">↗</span>
              </a>
            )}
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {model.data.pricing.free && (
              <div class="border border-line rounded-lg p-5 bg-paper-alt/40">
                <p class="font-mono text-xs uppercase tracking-[0.15em] text-emerald mb-2 font-medium">Free Option</p>
                <p class="text-ink-soft leading-relaxed text-sm">{model.data.pricing.free}</p>
              </div>
            )}
            {model.data.pricing.paid && (
              <div class="border border-line rounded-lg p-5 bg-paper-alt/40">
                <p class="font-mono text-xs uppercase tracking-[0.15em] text-gold mb-2 font-medium">Paid Plans</p>
                <p class="text-ink-soft leading-relaxed text-sm">{model.data.pricing.paid}</p>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- Model Varieties / Tiers -->
      {model.data.modelVariants && model.data.modelVariants.length > 0 && (
        <section id="models" class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Model Tiers</h2>
          </div>
          <div class="space-y-4">
            {model.data.modelVariants.map((variant) => (
              <div class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-6 border border-line bg-paper-alt/30 rounded-lg p-5 hover:border-emerald/45 transition-colors" style="box-shadow: 0 2px 8px var(--theme-shadow);">
                <div class="sm:w-48 shrink-0 flex items-center gap-3">
                  <span class={`h-2 w-2 rounded-full ${variant.freeTier ? 'bg-emerald' : 'bg-gold'}`} style={`box-shadow: 0 0 8px ${variant.freeTier ? 'var(--theme-emerald)' : 'var(--theme-gold)'}`}></span>
                  <p class="font-display text-lg text-ink">{variant.name}</p>
                </div>
                <p class="text-sm text-ink-soft leading-relaxed flex-1">{variant.details}</p>
                <span class={`font-mono text-[10px] uppercase tracking-wide border rounded px-2.5 py-1 shrink-0 w-fit ${variant.freeTier ? 'border-emerald/30 text-emerald bg-emerald-light' : 'border-line text-ink-soft bg-paper'}`}>
                  {variant.freeTier ? 'Free Tier' : 'Paid Plans'}
                </span>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Access Points -->
      {model.data.accessPlatforms && model.data.accessPlatforms.length > 0 && (
        <section id="access-points">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Access Points</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {model.data.accessPlatforms.map((platform) => (
              <div class="border border-line rounded-lg p-5 bg-paper-alt/40">
                <p class="font-display text-lg text-ink mb-1">{platform.name}</p>
                <p class="text-sm text-ink-soft leading-relaxed">{platform.details}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Use Cases -->
      {model.data.useCases && model.data.useCases.length > 0 && (
        <section id="use-cases" class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Use Cases</h2>
          </div>
          <div class="space-y-5">
            {model.data.useCases.map((useCase, idx) => (
              <div class={`border-t border-line pt-5 ${idx === 0 ? 'first:border-t-0 first:pt-0' : ''}`}>
                <p class="font-display text-lg text-ink mb-1">{useCase.title}</p>
                <p class="text-sm text-ink-soft leading-relaxed">{useCase.details}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Quick Prompt Ideas -->
      {model.data.quickIdeas && model.data.quickIdeas.length > 0 && (
        <section id="quick-ideas" class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Quick Prompt Ideas</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {model.data.quickIdeas.map((idea) => (
              <div class="border border-line rounded-lg p-5 bg-paper-alt flex flex-col justify-between" style="box-shadow: 0 2px 8px var(--theme-shadow);">
                <p class="font-mono text-sm leading-relaxed text-ink/90">"{idea}"</p>
                <div class="mt-4 flex justify-end">
                  <button 
                    onclick="copyPrompt(this)" 
                    data-text={idea} 
                    class="inline-flex items-center justify-center font-mono text-[10px] uppercase tracking-widest text-ink-soft hover:text-emerald border border-line rounded px-2.5 py-1 transition-colors bg-paper/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald cursor-pointer"
                    style="box-shadow: 0 1px 2px var(--theme-shadow);"
                  >
                    Copy
                  </button>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Pros & Cons -->
      {((model.data.pros && model.data.pros.length > 0) || (model.data.cons && model.data.cons.length > 0)) && (
        <section id="pros-cons" class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Pros &amp; Cons</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-0 border border-line bg-paper-alt/20 rounded-lg p-6 sm:p-8" style="box-shadow: 0 2px 8px var(--theme-shadow);">
            <div class="sm:pr-8">
              <p class="font-mono text-xs uppercase tracking-[0.15em] text-emerald font-semibold mb-4">Pros</p>
              <ul class="space-y-3">
                {model.data.pros.map((pro) => (
                  <li class="flex gap-3 text-sm text-ink-soft">
                    <span class="text-emerald font-mono font-bold">✓</span>
                    <span>{pro}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="sm:pl-8 sm:border-l border-line">
              <p class="font-mono text-xs uppercase tracking-[0.15em] text-brick font-semibold mb-4">Cons</p>
              <ul class="space-y-3">
                {model.data.cons.map((con) => (
                  <li class="flex gap-3 text-sm text-ink-soft">
                    <span class="text-brick font-mono font-bold">✕</span>
                    <span>{con}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </section>
      )}

      <!-- Latest Updates -->
      {model.data.latestUpdates && model.data.latestUpdates.length > 0 && (
        <section id="updates" class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Latest Updates</h2>
          </div>
          <div class="relative pl-6 border-l-2 border-line space-y-8">
            {model.data.latestUpdates.map((update, idx) => (
              <div class="relative">
                <span 
                  class={`absolute -left-[29px] top-1 h-3 w-3 rounded-full border-2 border-paper ${idx === 0 ? 'bg-emerald' : 'bg-line'}`}
                  style={idx === 0 ? 'box-shadow: 0 0 8px var(--theme-emerald);' : ''}
                ></span>
                <p class="font-mono text-xs text-emerald uppercase tracking-[0.15em] mb-1 font-medium">Update Details</p>
                <p class="font-display text-lg text-ink mb-1">{update.title}</p>
                <p class="text-sm text-ink-soft leading-relaxed">{update.details}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Alternatives -->
      {model.data.alternatives && model.data.alternatives.length > 0 && (
        <section id="alternatives" class="scroll-mt-24">
          <div class="flex items-center gap-3 mb-5">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Alternatives Worth Considering</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            {model.data.alternatives.map((alt) => {
              const TagName = alt.link ? 'a' : 'div';
              return (
                <TagName 
                  href={alt.link} 
                  class={`block border border-line rounded-lg p-6 bg-paper-alt/40 transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald ${alt.link ? 'hover:border-emerald hover:bg-paper-alt/80 no-underline' : ''}`}
                  style="box-shadow: 0 2px 8px var(--theme-shadow);"
                >
                  <p class="font-display text-lg text-ink mb-2">{alt.name}</p>
                  <p class="text-sm text-ink-soft leading-relaxed">{alt.value}</p>
                  {alt.link && (
                    <p class="mt-3 font-mono text-xs uppercase tracking-[0.15em] text-emerald flex items-center gap-1">
                      <span>Compare instead</span> <span class="inline-block translate-y-[0.5px] font-sans">→</span>
                    </p>
                  )}
                </TagName>
              );
            })}
          </div>
        </section>
      )}

      <!-- Editor's Final Verdict -->
      {model.data.editorsReview && (
        <section id="editors-review" class="scroll-mt-24 border-l-4 border-emerald bg-paper-alt rounded-r-lg p-6 sm:p-8" style="box-shadow: inset 0 0 8px var(--theme-shadow);">
          <p class="font-mono text-xs uppercase tracking-[0.15em] text-emerald mb-3">The Editor's Take — {model.data.editorsReview.rating}</p>
          <blockquote class="font-display italic text-xl sm:text-2xl text-ink leading-snug mb-5">
            "{model.data.editorsReview.verdict}"
          </blockquote>
          <p class="text-ink-soft leading-relaxed font-body">
            {model.data.editorsReview.handsOnNotes}
          </p>
        </section>
      )}

    </div>
  </div>

  <!-- Clipboard Copy Javascript -->
  <script is:inline>
    function copyPrompt(btn) {
      const text = btn.getAttribute('data-text');
      const original = btn.textContent;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
          btn.textContent = 'Copied ✓';
          btn.classList.add('text-emerald', 'border-emerald');
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('text-emerald', 'border-emerald');
          }, 1500);
        }).catch(() => {
          btn.textContent = 'Press Ctrl+C';
          setTimeout(() => {
            btn.textContent = original;
          }, 1500);
        });
      }
    }
  </script>
</Layout>