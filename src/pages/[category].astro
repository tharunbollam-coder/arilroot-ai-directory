---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Use getStaticPaths to generate all category pages at build time
export async function getStaticPaths() {
  const allModels = await getCollection('models');
  
  // Extract unique categories
  const categories = [...new Set(allModels.map(model => model.data.category))];
  
  // Map categories to parameters and pass matching models as props
  return categories.map(category => {
    const filteredModels = allModels.filter(model => model.data.category === category);
    return {
      params: { category },
      props: { models: filteredModels }
    };
  });
}

const { category } = Astro.params;
const { models } = Astro.props;

// Human-friendly mapping for category titles
const categoryDisplayNames: Record<string, string> = {
  'text-models': 'Text Models & Chatbots',
  'image-models': 'Image & Art Generators',
  'audio-models': 'Audio & Speech Synthesizers',
  'video-models': 'Video Generators',
};

const displayName = categoryDisplayNames[category] || category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
---

<Layout 
  title={`${displayName} - ArilRoot AI Directory`}
  description={`Explore in-depth reviews, specifications, and comparison guides for the best ${displayName} AI models.`}
>
  <div class="container mx-auto max-w-6xl px-6 py-12">
    
    <!-- Breadcrumb -->
    <nav class="flex mb-6" aria-label="Breadcrumb">
      <ol class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.15em] text-ink-soft">
        <li>
          <a href="/" class="hover:text-emerald transition-colors no-underline">Home</a>
        </li>
        <li>
          <span class="text-line select-none">·</span>
        </li>
        <li>
          <span class="text-ink">{displayName}</span>
        </li>
      </ol>
    </nav>

    <!-- Header Card -->
    <header class="bg-paper-alt border border-line rounded-lg p-6 sm:p-10 mb-10 shadow-[0_4px_12px_rgba(0,0,0,0.01)]">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-emerald mb-3">Category Directory</p>
      <h1 class="font-display font-medium text-4xl sm:text-5xl text-ink tracking-tight leading-none mb-6">
        {displayName}
      </h1>
      <div class="pt-6 border-t border-line">
        <p class="text-ink-soft leading-relaxed max-w-4xl font-display italic text-lg sm:text-xl">
          "A hand-picked selection of the most powerful models in the {displayName} ecosystem. Browse detailed capabilities, architectures, and full analysis sheets below."
        </p>
      </div>
    </header>

    <!-- Model Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {models.map((model) => {
        const modelSlug = model.id.split('/').pop();
        return (
          <article 
            id={`model-${modelSlug}`}
            class="bg-paper-alt border border-line rounded-lg p-6 flex flex-col justify-between hover:border-emerald/45 shadow-[0_4px_12px_rgba(0,0,0,0.01)] transition-colors"
          >
            <div>
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                  {model.data.logo && (
                    <div class="w-12 h-12 rounded bg-paper border border-line p-2 flex items-center justify-center shrink-0">
                      <img 
                        src={model.data.logo} 
                        alt={`${model.data.title} brand mark`} 
                        class="w-full h-full object-contain"
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div>
                    <h2 class="font-display text-2xl text-ink leading-tight">
                      <a href={`/${category}/${modelSlug}`} class="hover:text-emerald transition-colors no-underline">{model.data.title}</a>
                    </h2>
                    <p class="font-mono text-[11px] uppercase tracking-wide text-ink-soft mt-1 font-medium">by {model.data.creator}</p>
                  </div>
                </div>

                <div class="flex gap-2">
                  {model.data.pricingTier === 'Free' && (
                    <span class="font-mono text-[10px] uppercase tracking-wide border border-emerald/30 text-emerald bg-emerald-light rounded px-2.5 py-1">
                      Free
                    </span>
                  )}
                  {model.data.pricingTier === 'Freemium' && (
                    <span class="font-mono text-[10px] uppercase tracking-wide border border-emerald/30 text-emerald bg-emerald-light rounded px-2.5 py-1">
                      Freemium
                    </span>
                  )}
                  {model.data.pricingTier === 'Paid' && (
                    <span class="font-mono text-[10px] uppercase tracking-wide border border-line text-ink-soft bg-paper rounded px-2.5 py-1">
                      Paid
                    </span>
                  )}
                </div>
              </div>

              <p class="text-ink-soft text-sm leading-relaxed mb-6 line-clamp-3">
                {model.data.description}
              </p>
            </div>

            <div class="border-t border-line pt-4">
              <a 
                href={`/${category}/${modelSlug}`} 
                class="w-full inline-flex items-center justify-center gap-1.5 border border-line bg-paper px-4 py-2 rounded font-mono text-xs uppercase tracking-[0.15em] hover:bg-emerald hover:text-white hover:border-emerald transition-all no-underline shadow-sm"
              >
                <span>Read Full Review</span> <span class="inline-block translate-y-[0.5px] font-sans">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Layout>