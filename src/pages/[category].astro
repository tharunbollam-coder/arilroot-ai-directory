---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ToolSearch from '../components/ToolSearch.astro';

// Use getStaticPaths to generate all category pages at build time
export async function getStaticPaths() {
  const allModels = await getCollection('models');
  
  // Extract unique categories
  const categories = [...new Set(allModels.map(model => model.data.category))];
  
  // Map categories to parameters and pass matching models as props
  return categories.map(category => {
    const filteredModels = allModels.filter(model => model.data.category === category);
    return {
      params: { category },
      props: { models: filteredModels, allModels }
    };
  });
}

const { category } = Astro.params;
const { models, allModels } = Astro.props;

// Human-friendly mapping for category titles
const categoryDisplayNames: Record<string, string> = {
  'text-models': 'Text Models & Chatbots',
  'image-models': 'Image & Art Generators',
  'audio-models': 'Audio & Speech Synthesizers',
  'video-models': 'Video Generators',
};

const displayName = categoryDisplayNames[category] || category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

// Build search index scoped to ALL tools (filtering happens client-side via scopeCategory)
const searchIndex = JSON.stringify(allModels.map(model => {
  const slug = model.id.split('/').pop();
  return {
    title: model.data.title,
    link: `/${model.data.category}/${slug}`,
    category: model.data.category,
    categoryLabel: categoryDisplayNames[model.data.category] || model.data.category.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    logo: model.data.logo || '',
    shortDescription: model.data.description.slice(0, 120),
  };
}));

const totalCount = models.length;
---

<Layout 
  title={`${displayName} - ArilRoot AI Directory`}
  description={`Explore detailed breakdowns, specifications, and comparison guides for the best ${displayName} AI models.`}
>
  <div class="container mx-auto max-w-6xl px-6 py-12">
    
    <!-- Breadcrumb -->
    <nav class="flex mb-6" aria-label="Breadcrumb">
      <ol class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.15em] text-ink-soft">
        <li>
          <a href="/" class="hover:text-emerald transition-colors no-underline">Home</a>
        </li>
        <li>
          <span class="text-line select-none">·</span>
        </li>
        <li>
          <span class="text-ink">{displayName}</span>
        </li>
      </ol>
    </nav>

    <!-- Header Card -->
    <header class="bg-paper-alt border border-line rounded-lg p-6 sm:p-10 mb-10" style="box-shadow: 0 4px 12px var(--theme-shadow);">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-emerald mb-3">Category Directory</p>
      <h1 class="font-display font-medium text-4xl sm:text-5xl text-ink tracking-tight leading-none mb-6">
        {displayName}
      </h1>
      <div class="pt-6 border-t border-line">
        <p class="text-ink-soft leading-relaxed max-w-4xl font-display italic text-lg sm:text-xl">
          "A hand-picked selection of the most powerful models in the {displayName} ecosystem. Browse detailed capabilities, architectures, and full analysis sheets below."
        </p>
      </div>
    </header>

    <!-- Category Search -->
    <div class="mb-6">
      <ToolSearch
        searchIndex={searchIndex}
        scopeCategory={category}
        placeholder={`Search ${displayName}…`}
      />
    </div>

    <!-- Filter Bar -->
    <div id="filter-bar" class="mb-8 bg-paper-alt border border-line rounded-xl p-4 sm:p-5" style="box-shadow: 0 2px 8px var(--theme-shadow);">
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
        <!-- Badge Filter -->
        <div class="flex flex-col gap-2">
          <span class="font-mono text-[10px] uppercase tracking-wider text-ink-soft font-semibold">Badge</span>
          <div class="flex flex-wrap gap-1.5" id="badge-filters">
            <button data-filter-group="badge" data-filter-value="all" class="filter-pill active font-mono text-[11px] uppercase tracking-wider font-semibold rounded-md px-3 py-1.5 border transition-all duration-200 cursor-pointer select-none shadow-2xs">
              All
            </button>
            <button data-filter-group="badge" data-filter-value="main-stack" class="filter-pill font-mono text-[11px] uppercase tracking-wider font-semibold rounded-md px-3 py-1.5 border transition-all duration-200 cursor-pointer select-none shadow-2xs">
              Main Stack
            </button>
            <button data-filter-group="badge" data-filter-value="hands-on-tested" class="filter-pill font-mono text-[11px] uppercase tracking-wider font-semibold rounded-md px-3 py-1.5 border transition-all duration-200 cursor-pointer select-none shadow-2xs">
              Hands-On Tested
            </button>
            <button data-filter-group="badge" data-filter-value="watchlist" class="filter-pill font-mono text-[11px] uppercase tracking-wider font-semibold rounded-md px-3 py-1.5 border transition-all duration-200 cursor-pointer select-none shadow-2xs">
              Watchlist
            </button>
          </div>
        </div>

        <!-- Divider -->
        <div class="hidden sm:block w-px h-10 bg-line self-end mb-0.5"></div>

        <!-- Pricing Filter -->
        <div class="flex flex-col gap-2">
          <span class="font-mono text-[10px] uppercase tracking-wider text-ink-soft font-semibold">Pricing</span>
          <div class="flex flex-wrap gap-1.5" id="pricing-filters">
            <button data-filter-group="pricing" data-filter-value="all" class="filter-pill active font-mono text-[11px] uppercase tracking-wider font-semibold rounded-md px-3 py-1.5 border transition-all duration-200 cursor-pointer select-none shadow-2xs">
              All
            </button>
            <button data-filter-group="pricing" data-filter-value="Free" class="filter-pill font-mono text-[11px] uppercase tracking-wider font-semibold rounded-md px-3 py-1.5 border transition-all duration-200 cursor-pointer select-none shadow-2xs">
              Free
            </button>
            <button data-filter-group="pricing" data-filter-value="Freemium" class="filter-pill font-mono text-[11px] uppercase tracking-wider font-semibold rounded-md px-3 py-1.5 border transition-all duration-200 cursor-pointer select-none shadow-2xs">
              Freemium
            </button>
            <button data-filter-group="pricing" data-filter-value="Paid" class="filter-pill font-mono text-[11px] uppercase tracking-wider font-semibold rounded-md px-3 py-1.5 border transition-all duration-200 cursor-pointer select-none shadow-2xs">
              Paid
            </button>
          </div>
        </div>
      </div>

      <!-- Result Count & Clear -->
      <div class="mt-4 pt-3 border-t border-line/50 flex items-center justify-between">
        <p id="filter-result-count" class="font-mono text-xs text-ink-soft">
          <span id="count-number" class="text-emerald font-semibold">{totalCount}</span> {totalCount === 1 ? 'tool' : 'tools'}
        </p>
        <button id="clear-filters" class="hidden font-mono text-[11px] uppercase tracking-wider text-emerald hover:text-ink transition-colors cursor-pointer font-semibold">
          Clear filters ×
        </button>
      </div>
    </div>

    <!-- Empty State -->
    <div id="filter-empty-state" class="hidden text-center py-16">
      <p class="font-display text-xl text-ink-soft mb-2">No tools match these filters</p>
      <p class="text-sm text-ink-soft/60">Try adjusting your filter criteria above.</p>
    </div>

    <!-- Model Cards Grid -->
    <div id="tools-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {models.map((model) => {
        const modelSlug = model.id.split('/').pop();
        return (
          <article 
            id={`model-${modelSlug}`}
            class="tool-card bg-paper-alt border border-line rounded-lg p-6 flex flex-col justify-between hover:border-emerald/45 transition-colors"
            style="box-shadow: 0 4px 12px var(--theme-shadow);"
            data-test-status={model.data.testStatus}
            data-pricing-tier={model.data.pricingTier}
          >
            <div>
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                  {model.data.logo && (
                    <div class="logo-box w-12 h-12">
                      <img 
                        src={model.data.logo} 
                        alt={`${model.data.title} brand mark`} 
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div>
                    <h2 class="font-display text-2xl text-ink leading-tight">
                      <a href={`/${category}/${modelSlug}`} class="hover:text-emerald transition-colors no-underline">{model.data.title}</a>
                    </h2>
                    <p class="font-mono text-[11px] uppercase tracking-wide text-ink-soft mt-1 font-medium">by {model.data.creator}</p>
                  </div>
                </div>

                <div class="flex flex-wrap gap-2 items-center justify-end">
                  {model.data.testStatus === 'main-stack' && (
                    <span class="font-mono text-[10px] uppercase tracking-wider border border-emerald/35 text-emerald bg-emerald-light/90 rounded-md px-2.5 py-1 inline-flex items-center gap-1.5 font-semibold shadow-2xs">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Main Stack
                    </span>
                  )}
                  {model.data.testStatus === 'hands-on-tested' && (
                    <span class="font-mono text-[10px] uppercase tracking-wider border border-gold/35 text-gold bg-gold-light/90 rounded-md px-2.5 py-1 inline-flex items-center gap-1.5 font-semibold shadow-2xs">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19 14.5" />
                      </svg>
                      Hands-On Tested
                    </span>
                  )}
                  {model.data.testStatus === 'watchlist' && (
                    <span class="font-mono text-[10px] uppercase tracking-wider border border-line text-ink-soft bg-paper rounded-md px-2.5 py-1 inline-flex items-center gap-1.5 font-semibold shadow-2xs">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      Watchlist
                    </span>
                  )}
                  {model.data.pricingTier === 'Free' && (
                    <span class="font-mono text-[10px] uppercase tracking-wider border border-emerald/35 text-emerald bg-emerald-light/90 rounded-md px-2.5 py-1 font-semibold shadow-2xs">
                      Free
                    </span>
                  )}
                  {model.data.pricingTier === 'Freemium' && (
                    <span class="font-mono text-[10px] uppercase tracking-wider border border-emerald/35 text-emerald bg-emerald-light/90 rounded-md px-2.5 py-1 font-semibold shadow-2xs">
                      Freemium
                    </span>
                  )}
                  {model.data.pricingTier === 'Paid' && (
                    <span class="font-mono text-[10px] uppercase tracking-wider border border-line text-ink-soft bg-paper rounded-md px-2.5 py-1 font-semibold shadow-2xs">
                      Paid
                    </span>
                  )}
                </div>
              </div>

              <p class="text-ink-soft text-sm leading-relaxed mb-6 line-clamp-3">
                {model.data.description}
              </p>
            </div>

            <div class="border-t border-line pt-4">
              <a 
                href={`/${category}/${modelSlug}`} 
                class="w-full inline-flex items-center justify-center gap-1.5 border border-line bg-paper px-4 py-2 rounded font-mono text-xs uppercase tracking-[0.15em] hover:bg-emerald hover:border-emerald transition-all no-underline"
                style="box-shadow: 0 1px 3px var(--theme-shadow); color: var(--theme-ink);"
                onmouseenter="this.style.color='var(--theme-btn-hover-text)'"
                onmouseleave="this.style.color='var(--theme-ink)'"
              >
                <span>View Full Breakdown</span> <span class="inline-block translate-y-[0.5px] font-sans">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <style>
    /* Filter pill default (inactive) state */
    .filter-pill {
      background-color: var(--theme-paper);
      border-color: var(--theme-line);
      color: var(--theme-ink-soft);
    }
    .filter-pill:hover {
      border-color: var(--theme-emerald);
      color: var(--theme-ink);
    }
    /* Filter pill active state */
    .filter-pill.active {
      background-color: var(--theme-emerald);
      border-color: var(--theme-emerald);
      color: #fff;
    }
    [data-theme="dark"] .filter-pill.active {
      color: #0C1017;
    }
    /* Hide filtered-out cards */
    .tool-card.filter-hidden {
      display: none;
    }
  </style>

  <script is:inline>
    (function() {
      const grid = document.getElementById('tools-grid');
      const emptyState = document.getElementById('filter-empty-state');
      const countNumber = document.getElementById('count-number');
      const countContainer = document.getElementById('filter-result-count');
      const clearBtn = document.getElementById('clear-filters');
      if (!grid) return;

      const allCards = grid.querySelectorAll('.tool-card');
      let activeBadge = 'all';
      let activePricing = 'all';

      // Attach click handlers to all filter pills
      document.querySelectorAll('.filter-pill').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var group = this.getAttribute('data-filter-group');
          var value = this.getAttribute('data-filter-value');

          // Update active state for the group
          document.querySelectorAll('.filter-pill[data-filter-group="' + group + '"]').forEach(function(b) {
            b.classList.remove('active');
          });
          this.classList.add('active');

          if (group === 'badge') activeBadge = value;
          if (group === 'pricing') activePricing = value;

          applyFilters();
        });
      });

      // Clear filters button
      if (clearBtn) {
        clearBtn.addEventListener('click', function() {
          activeBadge = 'all';
          activePricing = 'all';

          document.querySelectorAll('.filter-pill').forEach(function(btn) {
            btn.classList.remove('active');
          });
          document.querySelectorAll('.filter-pill[data-filter-value="all"]').forEach(function(btn) {
            btn.classList.add('active');
          });

          applyFilters();
        });
      }

      function applyFilters() {
        var visibleCount = 0;

        allCards.forEach(function(card) {
          var testStatus = card.getAttribute('data-test-status');
          var pricingTier = card.getAttribute('data-pricing-tier');

          var badgeMatch = (activeBadge === 'all') || (testStatus === activeBadge);
          var pricingMatch = (activePricing === 'all') || (pricingTier === activePricing);

          if (badgeMatch && pricingMatch) {
            card.classList.remove('filter-hidden');
            visibleCount++;
          } else {
            card.classList.add('filter-hidden');
          }
        });

        // Update count
        if (countNumber) {
          countNumber.textContent = visibleCount;
        }
        if (countContainer) {
          var suffix = visibleCount === 1 ? ' tool' : ' tools';
          countContainer.innerHTML = '<span id="count-number" class="text-emerald font-semibold">' + visibleCount + '</span>' + suffix;
        }

        // Toggle empty state
        if (emptyState) {
          if (visibleCount === 0) {
            emptyState.classList.remove('hidden');
            grid.classList.add('hidden');
          } else {
            emptyState.classList.add('hidden');
            grid.classList.remove('hidden');
          }
        }

        // Toggle clear button visibility
        var isFiltered = (activeBadge !== 'all' || activePricing !== 'all');
        if (clearBtn) {
          if (isFiltered) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
        }
      }
    })();
  </script>
</Layout>