---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

// Use getStaticPaths to generate all category pages at build time
export async function getStaticPaths() {
  const allModels = await getCollection('models');
  
  // Extract unique categories
  const categories = [...new Set(allModels.map(model => model.data.category))];
  
  // Map categories to parameters and pass matching models as props
  return categories.map(category => {
    const filteredModels = allModels.filter(model => model.data.category === category);
    return {
      params: { category },
      props: { models: filteredModels }
    };
  });
}

const { category } = Astro.params;
const { models } = Astro.props;

// Human-friendly mapping for category titles
const categoryDisplayNames: Record<string, string> = {
  'text-models': 'Text Models & Chatbots',
  'image-models': 'Image & Art Generators',
  'audio-models': 'Audio & Speech Synthesizers',
  'video-models': 'Video Generators',
};

const displayName = categoryDisplayNames[category] || category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
---

<Layout 
  title={`${displayName} - ArilRoot AI Directory`}
  description={`Explore detailed breakdowns, specifications, and comparison guides for the best ${displayName} AI models.`}
>
  <div class="container mx-auto max-w-6xl px-6 py-12">
    
    <!-- Breadcrumb -->
    <nav class="flex mb-6" aria-label="Breadcrumb">
      <ol class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.15em] text-ink-soft">
        <li>
          <a href="/" class="hover:text-emerald transition-colors no-underline">Home</a>
        </li>
        <li>
          <span class="text-line select-none">·</span>
        </li>
        <li>
          <span class="text-ink">{displayName}</span>
        </li>
      </ol>
    </nav>

    <!-- Header Card -->
    <header class="bg-paper-alt border border-line rounded-lg p-6 sm:p-10 mb-10" style="box-shadow: 0 4px 12px var(--theme-shadow);">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-emerald mb-3">Category Directory</p>
      <h1 class="font-display font-medium text-4xl sm:text-5xl text-ink tracking-tight leading-none mb-6">
        {displayName}
      </h1>
      <div class="pt-6 border-t border-line">
        <p class="text-ink-soft leading-relaxed max-w-4xl font-display italic text-lg sm:text-xl">
          "A hand-picked selection of the most powerful models in the {displayName} ecosystem. Browse detailed capabilities, architectures, and full analysis sheets below."
        </p>
      </div>
    </header>

    <!-- Model Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {models.map((model) => {
        const modelSlug = model.id.split('/').pop();
        return (
          <article 
            id={`model-${modelSlug}`}
            class="bg-paper-alt border border-line rounded-lg p-6 flex flex-col justify-between hover:border-emerald/45 transition-colors"
            style="box-shadow: 0 4px 12px var(--theme-shadow);"
          >
            <div>
              <div class="flex items-start justify-between gap-4 mb-4">
                <div class="flex items-center gap-3">
                  {model.data.logo && (
                    <div class="logo-box w-12 h-12">
                      <img 
                        src={model.data.logo} 
                        alt={`${model.data.title} brand mark`} 
                        loading="lazy"
                      />
                    </div>
                  )}
                  <div>
                    <h2 class="font-display text-2xl text-ink leading-tight">
                      <a href={`/${category}/${modelSlug}`} class="hover:text-emerald transition-colors no-underline">{model.data.title}</a>
                    </h2>
                    <p class="font-mono text-[11px] uppercase tracking-wide text-ink-soft mt-1 font-medium">by {model.data.creator}</p>
                  </div>
                </div>

                <div class="flex flex-wrap gap-1.5 items-center justify-end">
                  {model.data.testStatus === 'main-stack' && (
                    <span class="font-mono text-[10px] uppercase tracking-wide border border-emerald/30 text-emerald bg-emerald-light rounded px-2 py-0.5 inline-flex items-center gap-1 font-medium">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                      Main Stack
                    </span>
                  )}
                  {model.data.testStatus === 'hands-on-tested' && (
                    <span class="font-mono text-[10px] uppercase tracking-wide border border-gold/30 text-gold bg-gold-light rounded px-2 py-0.5 inline-flex items-center gap-1 font-medium">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19 14.5" />
                      </svg>
                      Hands-On Tested
                    </span>
                  )}
                  {model.data.testStatus === 'watchlist' && (
                    <span class="font-mono text-[10px] uppercase tracking-wide border border-line text-ink-soft bg-paper rounded px-2 py-0.5 inline-flex items-center gap-1 font-medium">
                      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      Watchlist
                    </span>
                  )}
                  {model.data.pricingTier === 'Free' && (
                    <span class="font-mono text-[10px] uppercase tracking-wide border border-emerald/30 text-emerald bg-emerald-light rounded px-2 py-0.5">
                      Free
                    </span>
                  )}
                  {model.data.pricingTier === 'Freemium' && (
                    <span class="font-mono text-[10px] uppercase tracking-wide border border-emerald/30 text-emerald bg-emerald-light rounded px-2 py-0.5">
                      Freemium
                    </span>
                  )}
                  {model.data.pricingTier === 'Paid' && (
                    <span class="font-mono text-[10px] uppercase tracking-wide border border-line text-ink-soft bg-paper rounded px-2 py-0.5">
                      Paid
                    </span>
                  )}
                </div>
              </div>

              <p class="text-ink-soft text-sm leading-relaxed mb-6 line-clamp-3">
                {model.data.description}
              </p>
            </div>

            <div class="border-t border-line pt-4">
              <a 
                href={`/${category}/${modelSlug}`} 
                class="w-full inline-flex items-center justify-center gap-1.5 border border-line bg-paper px-4 py-2 rounded font-mono text-xs uppercase tracking-[0.15em] hover:bg-emerald hover:border-emerald transition-all no-underline"
                style="box-shadow: 0 1px 3px var(--theme-shadow); color: var(--theme-ink);"
                onmouseenter="this.style.color='var(--theme-btn-hover-text)'"
                onmouseleave="this.style.color='var(--theme-ink)'"
              >
                <span>View Full Breakdown</span> <span class="inline-block translate-y-[0.5px] font-sans">→</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</Layout>