---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import NewsCard from '../components/NewsCard.astro';
import ToolSearch from '../components/ToolSearch.astro';

// Fetch all model entries from content layer
const allModels = await getCollection('models');

// Fetch 3-4 most recent blog posts
const allBlogPosts = await getCollection('blog');
const recentBlogPosts = allBlogPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

// Fetch 3-4 most recent news entries
const allNews = await getCollection('news');
const recentNews = allNews
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

// Human-friendly mapping for category titles
const categoryDisplayNames: Record<string, string> = {
  'text-models': 'Text Models & Chatbots',
  'video-models': 'Video Generators',
};

// Extract unique categories from actual model entries, falling back to active categories during dev HMR
const extractedCategories = [...new Set(allModels.map(model => model.data.category))];
const categories = extractedCategories.length > 0 ? extractedCategories : ['text-models', 'video-models'];

// Human-friendly mapping for category descriptions
const categoryDescriptions: Record<string, string> = {
  'text-models': 'Advanced conversational agents, content generation utilities, coding assistants, and deep thinking calculators.',
  'video-models': 'Cutting-edge models transforming prompts and still frames into high-quality cinematic video clips.',
};

// Build search index for all tools (used by hero search and category search)
const searchIndex = JSON.stringify(allModels.map(model => {
  const slug = model.id.split('/').pop();
  return {
    title: model.data.title,
    link: `/${model.data.category}/${slug}`,
    category: model.data.category,
    categoryLabel: categoryDisplayNames[model.data.category] || model.data.category.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
    logo: model.data.logo || '',
    shortDescription: model.data.description.slice(0, 120),
  };
}));
---

<Layout title="ArilRoot - Discover the Future of Digital Intelligence">
  <!-- Hero Section -->
  <section class="container mx-auto max-w-6xl px-6 pt-20 pb-12 text-center">
    <p class="font-mono text-xs uppercase tracking-[0.25em] text-emerald mb-4">Curated AI Directory</p>
    <div class="max-w-4xl mx-auto">
      <h1 class="font-display font-medium text-5xl sm:text-7xl tracking-tight text-ink leading-[1.05]">
        Discover the Future of <br />
        <span class="text-emerald">Digital Intelligence</span>
      </h1>
      <p class="mt-6 font-display italic text-xl sm:text-2xl text-ink-soft leading-snug max-w-2xl mx-auto">
        "An elegantly curated catalog of state-of-the-art AI models. We analyze, detail, and catalog intelligence architectures to simplify integration for modern builders."
      </p>
    </div>

    <!-- Hero Search -->
    <div class="mt-10 max-w-xl mx-auto">
      <ToolSearch
        searchIndex={searchIndex}
        placeholder="Search all tools…"
      />
    </div>

    <div class="mt-6 flex justify-center">
      <a
        href="#categories"
        class="inline-flex items-center gap-2 border border-line bg-paper-alt px-6 py-3 rounded font-mono text-xs uppercase tracking-[0.15em] hover:bg-emerald hover:border-emerald transition-all no-underline"
        style="box-shadow: 0 1px 3px var(--theme-shadow); --tw-text-opacity:1; color: var(--theme-ink);"
        onmouseenter="this.style.color='var(--theme-btn-hover-text)'"
        onmouseleave="this.style.color='var(--theme-ink)'"
      >
        Explore Directories <span class="inline-block translate-y-[0.5px] font-sans">↓</span>
      </a>
    </div>
  </section>

  <!-- "How I Rate Tools" Explainer Section -->
  <section class="container mx-auto max-w-6xl px-6 py-16 border-t border-line">
    <div class="mb-12 text-center max-w-3xl mx-auto">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-emerald mb-3">Transparency & Credibility</p>
      <div class="flex items-center justify-center gap-3 mb-4">
        <span class="font-mono text-emerald text-sm font-semibold">§</span>
        <h2 class="font-display text-2xl sm:text-4xl text-ink font-medium">How I Rate Tools</h2>
      </div>
      <p class="text-ink-soft text-sm sm:text-base leading-relaxed">
        Every tool in this directory carries an explicit status badge reflecting my actual hands-on experience and relationship with the technology.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      <!-- Main Stack -->
      <div class="group relative bg-paper-alt border border-line rounded-xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:border-emerald/40 hover:-translate-y-1 overflow-hidden" style="box-shadow: 0 4px 16px var(--theme-shadow);">
        <div class="absolute top-0 left-0 right-0 h-1 bg-emerald rounded-t-xl opacity-80 group-hover:opacity-100 transition-opacity"></div>
        <div>
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-lg bg-emerald-light text-emerald border border-emerald/20 flex items-center justify-center shrink-0 shadow-2xs">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <span class="font-mono text-xs uppercase tracking-wider font-semibold border border-emerald/30 text-emerald bg-emerald-light/80 rounded-md px-3 py-1 inline-flex items-center gap-1.5 shadow-2xs">
              Main Stack
            </span>
          </div>
          <p class="text-sm text-ink-soft leading-relaxed font-body">
            I use this regularly. My review comes from real, everyday experience with it.
          </p>
        </div>
      </div>

      <!-- Hands-On Tested -->
      <div class="group relative bg-paper-alt border border-line rounded-xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:border-gold/40 hover:-translate-y-1 overflow-hidden" style="box-shadow: 0 4px 16px var(--theme-shadow);">
        <div class="absolute top-0 left-0 right-0 h-1 bg-gold rounded-t-xl opacity-80 group-hover:opacity-100 transition-opacity"></div>
        <div>
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-lg bg-gold-light text-gold border border-gold/20 flex items-center justify-center shrink-0 shadow-2xs">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19 14.5" />
              </svg>
            </div>
            <span class="font-mono text-xs uppercase tracking-wider font-semibold border border-gold/30 text-gold bg-gold-light/80 rounded-md px-3 py-1 inline-flex items-center gap-1.5 shadow-2xs">
              Hands-On Tested
            </span>
          </div>
          <p class="text-sm text-ink-soft leading-relaxed font-body">
            I've personally tried this enough to give an honest opinion, even though I don't use it daily.
          </p>
        </div>
      </div>

      <!-- Watchlist -->
      <div class="group relative bg-paper-alt border border-line rounded-xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:border-line hover:-translate-y-1 overflow-hidden" style="box-shadow: 0 4px 16px var(--theme-shadow);">
        <div class="absolute top-0 left-0 right-0 h-1 bg-line rounded-t-xl opacity-80 group-hover:bg-ink-soft/40 transition-colors"></div>
        <div>
          <div class="flex items-center gap-3 mb-5">
            <div class="w-10 h-10 rounded-lg bg-paper text-ink-soft border border-line flex items-center justify-center shrink-0 shadow-2xs">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <span class="font-mono text-xs uppercase tracking-wider font-semibold border border-line text-ink-soft bg-paper rounded-md px-3 py-1 inline-flex items-center gap-1.5 shadow-2xs">
              Watchlist
            </span>
          </div>
          <p class="text-sm text-ink-soft leading-relaxed font-body">
            I follow this closely but haven't used it myself yet, usually because of price. No star rating yet — just what I've learned from watching it closely. I plan to test this myself down the line and update this review once I have.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Categories Grid Section -->
  <section id="categories" class="container mx-auto max-w-6xl px-6 py-16 border-t border-line scroll-mt-24">
    <div class="mb-12">
      <p class="font-mono text-xs uppercase tracking-[0.25em] text-emerald mb-3">Model Domains</p>
      <div class="flex items-center gap-3">
        <span class="font-mono text-emerald text-sm">§</span>
        <h2 class="font-display text-2xl sm:text-3xl text-ink">Browse by Domain</h2>
      </div>
      <p class="text-ink-soft mt-3 text-sm max-w-lg">
        Select a category below to explore detailed breakdowns, variants, pricing structures, and best use cases.
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {categories.map((category) => {
        const displayName = categoryDisplayNames[category] || category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
        const description = categoryDescriptions[category] || `Discover detailed breakdowns and explore integrations for the latest ${category.replace('-', ' ')} engines.`;
        const count = allModels.filter(m => m.data.category === category).length;

        return (
          <div class="bg-paper-alt border border-line rounded-lg p-6 flex flex-col justify-between min-h-[18rem] hover:border-emerald/45 transition-colors" style="box-shadow: 0 4px 12px var(--theme-shadow);">
            <div>
              <div class="flex items-center justify-between mb-5">
                <div class="p-2 bg-emerald-light rounded text-emerald">
                  {category === 'text-models' && (
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  )}
                  {category === 'video-models' && (
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  )}
                  {category === 'image-models' && (
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  )}
                  {category === 'audio-models' && (
                    <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z" />
                    </svg>
                  )}
                </div>
                <span class="font-mono text-[11px] uppercase tracking-wide bg-paper border border-line rounded px-2.5 py-1 text-ink-soft">
                  {count} {count === 1 ? 'Model' : 'Models'}
                </span>
              </div>

              <h3 class="font-display text-2xl text-ink mb-3">{displayName}</h3>
              <p class="text-ink-soft text-sm leading-relaxed mb-6">{description}</p>
            </div>

            <div class="border-t border-line pt-4">
              <a
                href={`/${category}`}
                class="w-full inline-flex items-center justify-center gap-1.5 border border-line bg-paper px-4 py-2.5 rounded font-mono text-xs uppercase tracking-[0.15em] hover:bg-emerald hover:border-emerald transition-all no-underline"
                style="box-shadow: 0 1px 3px var(--theme-shadow); color: var(--theme-ink);"
                onmouseenter="this.style.color='var(--theme-btn-hover-text)'"
                onmouseleave="this.style.color='var(--theme-ink)'"
              >
                <span>Explore Category</span> <span class="inline-block translate-y-[0.5px] font-sans">→</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>
  </section>

  <!-- "From the Blog" Section -->
  {recentBlogPosts.length > 0 && (
    <section class="container mx-auto max-w-6xl px-6 py-16 border-t border-line">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-emerald mb-3">Latest Articles & Deep Dives</p>
          <div class="flex items-center gap-3">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">From the Blog</h2>
          </div>
          <p class="text-ink-soft mt-3 text-sm max-w-lg">
            Stay informed with our latest model breakdowns, head-to-head engine comparisons, and tactical prompting guides.
          </p>
        </div>

        <a
          href="/blog"
          class="inline-flex items-center gap-1.5 border border-line bg-paper-alt px-5 py-2.5 rounded font-mono text-xs uppercase tracking-[0.15em] hover:bg-emerald hover:border-emerald transition-all no-underline shrink-0 self-start sm:self-auto"
          style="box-shadow: 0 1px 3px var(--theme-shadow); color: var(--theme-ink);"
          onmouseenter="this.style.color='var(--theme-btn-hover-text)'"
          onmouseleave="this.style.color='var(--theme-ink)'"
        >
          <span>View All Posts</span> <span class="inline-block translate-y-[0.5px] font-sans">→</span>
        </a>
      </div>

      <!-- Equal-Height Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        {recentBlogPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </section>
  )}

  <!-- "Latest News" Section -->
  {recentNews.length > 0 && (
    <section class="container mx-auto max-w-6xl px-6 py-16 border-t border-line">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-emerald mb-3">Model Alerts & Updates</p>
          <div class="flex items-center gap-3">
            <span class="font-mono text-emerald text-sm">§</span>
            <h2 class="font-display text-2xl sm:text-3xl text-ink">Latest News</h2>
          </div>
          <p class="text-ink-soft mt-3 text-sm max-w-lg">
            Rapid updates on foundation model releases, feature announcements, and developer API rollouts.
          </p>
        </div>

        <a
          href="/news"
          class="inline-flex items-center gap-1.5 border border-line bg-paper-alt px-5 py-2.5 rounded font-mono text-xs uppercase tracking-[0.15em] hover:bg-emerald hover:border-emerald transition-all no-underline shrink-0 self-start sm:self-auto"
          style="box-shadow: 0 1px 3px var(--theme-shadow); color: var(--theme-ink);"
          onmouseenter="this.style.color='var(--theme-btn-hover-text)'"
          onmouseleave="this.style.color='var(--theme-ink)'"
        >
          <span>View All News</span> <span class="inline-block translate-y-[0.5px] font-sans">→</span>
        </a>
      </div>

      <!-- Equal-Height News Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-stretch">
        {recentNews.map((item) => (
          <NewsCard news={item} />
        ))}
      </div>
    </section>
  )}
</Layout>