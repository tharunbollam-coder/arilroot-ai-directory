---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "ArilRoot - Premium AI Directory", 
  description = "Discover the future of digital intelligence. A curated catalog of state-of-the-art AI models." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Title and Meta Description for SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Google Fonts: Fraunces, IBM Plex Sans, IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,500&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Theme initialisation — runs before paint to prevent flash -->
    <script is:inline>
      (function() {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        // Default is light (no attribute needed)
      })();
    </script>
  </head>
  <body id="top" class="min-h-screen flex flex-col font-body text-ink bg-paper antialiased">
    
    <!-- Sticky header -->
    <header class="sticky top-0 z-40 bg-paper/85 backdrop-blur-md border-b border-line" style="box-shadow: 0 1px 4px var(--theme-shadow);">
      <div class="container mx-auto max-w-6xl px-6 py-4 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-3 shrink-0 group no-underline">
          <span class="font-mono text-xs tracking-[0.15em] uppercase text-ink hover:text-emerald transition-colors font-medium">ArilRoot · AI Directory</span>
        </a>

        <div class="flex items-center gap-3 sm:gap-4">
          <nav class="hidden md:flex items-center gap-6 font-mono text-xs uppercase tracking-[0.15em] text-ink-soft">
            <a href="/" class="hover:text-emerald transition-colors no-underline">Home</a>
            <a href="/#categories" class="hover:text-emerald transition-colors no-underline">Categories</a>
            <a href="/blog" class="hover:text-emerald transition-colors no-underline">Blog</a>
            <a href="/news" class="hover:text-emerald transition-colors no-underline">News</a>
          </nav>

          <!-- Theme Toggle -->
          <button
            id="theme-toggle"
            type="button"
            class="theme-toggle"
            aria-label="Toggle dark mode"
            title="Toggle dark mode"
          >
            <!-- Sun icon (visible in dark mode → click to go light) -->
            <svg id="icon-sun" class="hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z" />
            </svg>
            <!-- Moon icon (visible in light mode → click to go dark) -->
            <svg id="icon-moon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-line bg-paper-alt py-10 mt-20">
      <div class="container mx-auto max-w-6xl px-6 flex flex-col sm:flex-row justify-between gap-3 text-xs font-mono text-ink-soft uppercase tracking-[0.15em]">
        <p>&copy; {new Date().getFullYear()} ArilRoot AI Directory — Independent Picks & Breakdowns</p>
        <div class="flex gap-6">
          <a href="/" class="hover:text-emerald transition-colors no-underline">Home</a>
          <a href="/blog" class="hover:text-emerald transition-colors no-underline">Blog</a>
          <a href="/news" class="hover:text-emerald transition-colors no-underline">News</a>
          <a href="https://arilroot.com" target="_blank" rel="noopener" class="hover:text-emerald transition-colors no-underline">Main Hub ↗</a>
          <a href="https://arilroot.com/about" class="hover:text-emerald transition-colors no-underline">About Us</a>
          <a href="https://arilroot.com/contact" class="hover:text-emerald transition-colors no-underline">Contact</a>
        </div>
      </div>
    </footer>

    <!-- Theme toggle logic -->
    <script is:inline>
      (function() {
        var btn     = document.getElementById('theme-toggle');
        var iconSun = document.getElementById('icon-sun');
        var iconMoon = document.getElementById('icon-moon');

        function applyIcons() {
          var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (isDark) {
            iconSun.classList.remove('hidden');
            iconMoon.classList.add('hidden');
          } else {
            iconSun.classList.add('hidden');
            iconMoon.classList.remove('hidden');
          }
        }

        // Initial icon state
        applyIcons();

        btn.addEventListener('click', function() {
          var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          if (isDark) {
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('theme', 'light');
          } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            localStorage.setItem('theme', 'dark');
          }
          applyIcons();
        });
      })();
    </script>
  </body>
</html>